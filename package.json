{
  "name": "neon-trinity-studio",
  "version": "0.10.0",
  "private": true,
  "description": "Neon Trinity – Musik, Alben, Live-Setlists und Suno-Import für Dex, Nix und Jax",
  "author": "Neon Trinity",
  "main": "desktop/main.cjs",
  "scripts": {
    "prestart": "node scripts/build-vendor.mjs && node scripts/prepare-source.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "build:web": "node scripts/build.mjs",
    "prebuild:win": "node scripts/build-vendor.mjs && node scripts/prepare-source.mjs",
    "prebuild:installer": "node scripts/build-vendor.mjs && node scripts/prepare-source.mjs",
    "build:win": "electron-builder --win nsis --x64",
    "build:installer": "electron-builder --win nsis --x64",
    "team:setup": "node scripts/setup-supabase.mjs",
    "build:vendor": "node scripts/build-vendor.mjs"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.4",
    "linkedom": "0.18.12"
  },
  "build": {
    "appId": "music.neontrinity.studio",
    "productName": "Neon Trinity Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "app/assets/icon.png",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Neon-Trinity-Studio-${version}-Windows.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "de_DE"
      ],
      "artifactName": "Neon-Trinity-Studio-Setup.exe",
      "include": "desktop/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mikejaeson1-wq",
        "repo": "neon-trinity",
        "releaseType": "release"
      }
    ],
    "protocols": [
      {
        "name": "Neon Trinity Mithören",
        "schemes": [
          "neontrinity"
        ]
      }
    ]
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@supabase/supabase-js": "2.118.0",
    "electron-updater": "6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mikejaeson1-wq/neon-trinity.git"
  }
}
